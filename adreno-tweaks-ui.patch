diff --git a/src/android/app/src/main/java/info/cemu/cemu/settings/adrenotweaks/AdrenoTweaksScreen.kt b/src/android/app/src/main/java/info/cemu/cemu/settings/adrenotweaks/AdrenoTweaksScreen.kt
